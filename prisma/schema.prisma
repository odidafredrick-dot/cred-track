// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CreditStatus {
  PENDING
  DUE
  OVERDUE
  PARTIALLY_PAID
  PAID
}

enum TopupStatus {
  PENDING
  PAID
  FAILED
}

enum UserRole {
  BUSINESS
  SUPPLIER
  INDIVIDUAL
  ADMIN
}

enum PaymentMode {
  POCHI
  PAY_BILL
  CASH
  TILL
}

enum RiskLevel {
  EXCELLENT
  LOW_RISK
  MODERATE_RISK
  HIGH_RISK
  VERY_HIGH_RISK
  DO_NOT_EXTEND
  LIMITED_HISTORY
  NO_HISTORY
}

enum PriceRuleScope {
  GLOBAL
  SUPPLIER
  CATEGORY
}

enum PriceRuleStatus {
  ACTIVE
  PAUSED
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  image         String?
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accounts  Account[]
  sessions  Session[]
}

model UserProfile {
  id           String       @id @default(cuid())
  userId       String       @unique
  role         UserRole
  businessName String?
  county       String?
  town         String?
  estate       String?
  phoneNumber  String?
  paymentMode  PaymentMode?
  description  String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([role])
}

model Customer {
  id        String   @id @default(cuid())
  userId    String
  name      String
  phone     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credits Credit[]

  @@unique([userId, phone])
  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  userId                String
  providerId            String    @map("provider")
  accountId             String
  password              String?   @db.Text
  accessToken           String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  scope                 String?
  refreshToken          String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Credit {
  id           String       @id @default(cuid())
  userId       String
  customerId   String
  customerName String
  customerPhone String     @default("")
  dueDate      DateTime
  totalAmount  Decimal      @db.Decimal(10, 2)
  amountPaid   Decimal      @db.Decimal(10, 2) @default(0)
  status       CreditStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  customer Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items    CreditItem[]
  payments CreditPayment[]

  @@index([userId])
  @@index([customerId])
}

model CreditBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model CreditTopup {
  id            String      @id @default(cuid())
  userId        String
  phone         String
  amount        Decimal     @db.Decimal(10, 2)
  creditsAdded  Int
  status        TopupStatus @default(PENDING)
  apiRef        String      @unique
  invoiceId     String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model CreditItem {
  id        String   @id @default(cuid())
  creditId  String
  name      String
  quantity  Int      @default(0)
  unitPrice Decimal  @db.Decimal(10, 2) @default(0)
  total     Decimal  @db.Decimal(10, 2) @default(0)
  createdAt DateTime @default(now())

  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)
}

model CreditPayment {
  id        String   @id @default(cuid())
  creditId  String
  amount    Decimal  @db.Decimal(10, 2)
  note      String?  @db.Text
  createdAt DateTime @default(now())

  credit Credit @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@index([creditId])
}

model HolwaRiskScoreSnapshot {
  id             String     @id @default(cuid())
  debtorPhone    String
  score          Int?
  riskLevel      RiskLevel
  recommendation String     @db.Text
  suggestedLimit Decimal    @db.Decimal(10, 2) @default(0)
  creditCount    Int        @default(0)
  calculatedAt   DateTime   @default(now())
  createdAt      DateTime   @default(now())

  checks HolwaRiskScoreCheck[]

  @@index([debtorPhone])
  @@index([calculatedAt])
}

model HolwaRiskScoreCheck {
  id              String                  @id @default(cuid())
  requesterUserId String
  debtorPhone     String
  score           Int?
  riskLevel       RiskLevel
  recommendation  String                  @db.Text
  suggestedLimit  Decimal                 @db.Decimal(10, 2) @default(0)
  snapshotId      String?
  createdAt       DateTime                @default(now())

  snapshot HolwaRiskScoreSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([requesterUserId])
  @@index([debtorPhone])
  @@index([createdAt])
}

model PriceRule {
  id                String          @id @default(cuid())
  name              String
  scope             PriceRuleScope  @default(GLOBAL)
  scopeValue        String?
  minMarkupPercent  Decimal?        @db.Decimal(10, 2)
  maxMarkupPercent  Decimal?        @db.Decimal(10, 2)
  minSellingPrice   Decimal?        @db.Decimal(10, 2)
  maxSellingPrice   Decimal?        @db.Decimal(10, 2)
  status            PriceRuleStatus @default(ACTIVE)
  notes             String?         @db.Text
  createdByUserId   String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  audits PriceAuditLog[]

  @@index([scope])
  @@index([status])
}

model PriceAuditLog {
  id          String   @id @default(cuid())
  priceRuleId String?
  adminUserId String
  action      String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  priceRule PriceRule? @relation(fields: [priceRuleId], references: [id], onDelete: SetNull)

  @@index([priceRuleId])
  @@index([adminUserId])
  @@index([createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  adminUserId String
  action      String
  targetType  String
  targetId    String?
  summary     String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([adminUserId])
  @@index([targetType])
  @@index([createdAt])
}

model SystemAnnouncement {
  id              String    @id @default(cuid())
  title           String
  body            String    @db.Text
  active          Boolean   @default(true)
  audience        UserRole?
  createdByUserId String?
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active])
  @@index([audience])
}

model FeatureFlag {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?  @db.Text
  enabled     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StockItem {
  id            String   @id @default(cuid())
  userId        String
  product       String
  buyingPrice   Decimal  @db.Decimal(10, 2)
  sellingPrice  Decimal  @db.Decimal(10, 2)
  quantity      Int
  supplierPhone String
  offers        String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model SupplierOrder {
  id           String   @id @default(cuid())
  supplierId   String
  buyerUserId  String
  buyerName    String
  buyerPhone   String?
  status       String   @default("SENT")
  totalAmount  Decimal  @db.Decimal(10, 2)
  smsStatus    String?
  smsMessageId String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  items SupplierOrderItem[]

  @@index([supplierId])
  @@index([buyerUserId])
}

model SupplierOrderItem {
  id        String  @id @default(cuid())
  orderId   String
  product   String
  price     Decimal @db.Decimal(10, 2)
  quantity  Int
  offers    String? @db.Text

  order SupplierOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model RestockRequest {
  id             String   @id @default(cuid())
  supplierUserId String
  businessUserId String
  stockItemId    String?
  product        String
  quantity       Int?
  status         String   @default("SENT")
  smsStatus      String?
  smsMessageId   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([supplierUserId])
  @@index([businessUserId])
  @@index([stockItemId])
}
